---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import me from '../assets/me.jpg';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
// Example systems that combine the services above. These are things I can build,
// not past client projects, so keep the wording hypothetical.
const examples = [
	{
		title: 'Equipment monitoring & maintenance alerts',
		text: "Connect sensors or existing machines to software that tracks cycles, run time, or temperatures. For example, count how many times a press runs and notify someone when it's due for maintenance.",
	},
	{
		title: 'Custom business software',
		text: "An application built around how your business actually works. Job tracking, inventory, scheduling, a customer portal, or a replacement for a spreadsheet that's gotten out of hand.",
	},
	{
		title: 'Workflow automation & integrations',
		text: 'Get the tools you already use talking to each other. No more typing the same data into two systems. Records stay in sync, and details from incoming emails and documents get pulled in automatically.',
	},
	{
		title: 'Replacing aging software',
		text: "An old Access database, desktop program, or internal tool nobody wants to maintain anymore. I can rebuild it as a web app your team can use from anywhere, and bring the existing data along.",
	},
];
---

<Base
	title="Gilbert Yoder — Software Developer"
	description="Gilbert Yoder — software developer in Bonners Ferry, Idaho. Custom software that connects systems, equipment, and workflows: backend, cloud infrastructure, hardware and IoT, AI, and frontend."
>
	<section class="hero">
		<figure class="photo">
			<Image
				src={me}
				alt="Portrait of Gilbert Yoder"
				width={480}
				height={600}
				fit="cover"
				position="center"
				quality={80}
				loading="eager"
			/>
		</figure>

		<div class="intro">
			<h1>Gilbert Yoder</h1>
			<p class="lede">
				Software developer building custom software that connects your systems, equipment, and day-to-day
				work. From the app your team uses, to the server it runs on, to the machines it talks to.
			</p>
			<p class="loc">📍 Bonners Ferry, Idaho</p>
			<a class="btn" href="mailto:yodergilbert1@gmail.com?subject=Hello%20Gilbert">
				Get in touch →
			</a>
			<div class="socials">
				<a class="social" href="https://www.linkedin.com/in/gilbert-yoder-6330211b3/" target="_blank" rel="noopener">
					<svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
						<path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
					</svg>
					LinkedIn ↗
				</a>
				<a class="social" href="https://github.com/GilbertYoder" target="_blank" rel="noopener">
					<svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
						<path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
					</svg>
					GitHub ↗
				</a>
			</div>
		</div>
	</section>

	<section>
		<h2><span class="hash">##</span> What I do</h2>
		<ul class="skills">
			{
				services.map((s) => (
					<li>
						<a href={`/services/${s.id}/`}>
							<div class="card-head">
								<h3>{s.data.title}</h3>
								<ServiceIcon name={s.data.icon} />
							</div>
							<p>{s.data.summary}</p>
							<span class="more">read more →</span>
						</a>
					</li>
				))
			}
			<li class="cta">
				<a href="mailto:yodergilbert1@gmail.com?subject=Project%20idea">
					<h3>Have something different in mind?</h3>
					<p>Not every problem fits neatly into a category.</p>
					<span class="more">Let's talk about it →</span>
				</a>
			</li>
		</ul>
	</section>

	<section class="build">
		<h2><span class="hash">##</span> Practical applications</h2>
		<div class="examples">
			{
				examples.map((e) => (
					<article>
						<h3>{e.title}</h3>
						<p>{e.text}</p>
					</article>
				))
			}
		</div>
	</section>
</Base>

<style>
	.hero {
		display: grid;
		grid-template-columns: 240px 1fr;
		gap: 2.5rem;
		align-items: center;
		padding: 2.5rem 0;
	}

	.photo {
		position: relative;
		margin: 0;
		width: 240px;
		height: 300px;
		border: 2px solid var(--line);
		background: var(--paper-edge);
		box-shadow: 5px 5px 0 var(--accent);
		transform: rotate(-1.5deg);
		overflow: hidden;
	}

	.photo :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: sepia(0.2) contrast(1.05);
	}

	.lede {
		margin: 0 0 0.75rem;
		font-size: 1.1rem;
	}

	.lede em {
		font-style: normal;
		background: linear-gradient(transparent 55%, rgba(180, 69, 43, 0.3) 55%);
	}

	.loc {
		margin: 0;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.skills {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(2, 1fr);
	}

	.skills a {
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: 1rem;
		border: 1.5px solid var(--line);
		background: var(--paper-edge);
		color: inherit;
		text-decoration: none;
		transition: transform 0.15s, box-shadow 0.15s;
	}

	.skills a:hover,
	.skills a:focus-visible {
		transform: translate(-2px, -2px);
		box-shadow: 4px 4px 0 var(--shadow);
		outline: none;
	}

	/* Title on the left, icon on the right of the same row. */
	.card-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.4rem;
	}

	.card-head h3 {
		margin: 0;
	}

	.skills :global(.service-icon) {
		flex-shrink: 0;
		width: 1.75rem;
		height: 1.75rem;
		color: var(--ink);
	}

	.skills a:hover :global(.service-icon) {
		color: var(--accent);
	}

	/* Closing call-to-action tile: quieter than the service cards. */
	.skills .cta a {
		justify-content: center;
		align-items: center;
		text-align: center;
		border: 1.5px dashed var(--rule);
		background: none;
	}

	.skills .cta a:hover,
	.skills .cta a:focus-visible {
		transform: none;
		box-shadow: none;
		border-color: var(--accent);
	}

	.skills .cta h3 {
		color: var(--muted);
	}

	.skills .cta .more {
		margin-top: 0;
		font-weight: 700;
	}

	.skills h3 {
		margin: 0.4rem 0;
		font-size: 1rem;
		line-height: 1.3;
	}

	.skills p {
		margin: 0 0 0.75rem;
		color: var(--muted);
		font-size: 0.85rem;
	}

	.more {
		font-family: var(--mono);
		margin-top: auto;
		color: var(--accent);
		font-size: 0.8rem;
	}

	/* Own line under the Get in touch button. */
	.socials {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		margin-top: 1rem;
	}

	.social {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--muted);
		font-size: 0.9rem;
		text-decoration: none;
	}

	.social:hover {
		color: var(--accent);
	}

	.social .icon {
		width: 1.1em;
		height: 1.1em;
	}

	.build {
		margin-top: 2.5rem;
	}

	.examples {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem 2rem;
	}

	.examples article {
		padding-top: 0.85rem;
		border-top: 2px solid var(--line);
	}

	.examples h3 {
		margin: 0 0 0.4rem;
		font-size: 1rem;
		line-height: 1.3;
	}

	.examples p {
		margin: 0;
		font-size: 0.85rem;
	}

	@media (max-width: 680px) {
		.hero {
			grid-template-columns: 1fr;
			justify-items: center;
			text-align: center;
			gap: 2rem;
		}

		.socials {
			justify-content: center;
		}

		.skills,
		.examples {
			grid-template-columns: 1fr;
		}
	}
</style>
