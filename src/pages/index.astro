---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import me from '../assets/me.jpg';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<Base
	title="Gilbert Yoder — Software Developer"
	description="Gilbert Yoder — software developer in Bonners Ferry, Idaho. Frontend, backend, cloud infrastructure, and AI integration."
>
	<section class="hero">
		<figure class="photo">
			<Image
				src={me}
				alt="Portrait of Gilbert Yoder"
				width={480}
				height={600}
				fit="cover"
				position="center"
				quality={80}
				loading="eager"
			/>
		</figure>

		<div class="intro">
			<h1>Gilbert Yoder</h1>
			<p class="lede">
				Software developer who can do <em>anything</em> between the browser and the data center.
			</p>
			<p class="loc">📍 Bonners Ferry, Idaho</p>
			<a class="btn" href="mailto:yodergilbert1@gmail.com?subject=Hello%20Gilbert">
				Get in touch →
			</a>
		</div>
	</section>

	<section>
		<h2><span class="hash">##</span> What I do</h2>
		<ul class="skills">
			{
				services.map((s) => (
					<li>
						<a href={`/services/${s.id}/`}>
							<code>./{s.data.cmd}</code>
							<h3>{s.data.title}</h3>
							<p>{s.data.summary}</p>
							<span class="more">read more →</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Base>

<style>
	.hero {
		display: grid;
		grid-template-columns: 240px 1fr;
		gap: 2.5rem;
		align-items: center;
		padding: 2.5rem 0;
	}

	.photo {
		position: relative;
		margin: 0;
		width: 240px;
		height: 300px;
		border: 2px solid var(--ink);
		background: var(--paper-edge);
		box-shadow: 5px 5px 0 var(--accent);
		transform: rotate(-1.5deg);
		overflow: hidden;
	}

	.photo :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: sepia(0.2) contrast(1.05);
	}

	.lede {
		margin: 0 0 0.75rem;
		font-size: 1.1rem;
	}

	.lede em {
		font-style: normal;
		background: linear-gradient(transparent 55%, rgba(180, 69, 43, 0.3) 55%);
	}

	.loc {
		margin: 0;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.skills {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(2, 1fr);
	}

	.skills a {
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: 1rem;
		border: 1.5px solid var(--ink);
		background: var(--paper-edge);
		color: inherit;
		text-decoration: none;
		transition: transform 0.15s, box-shadow 0.15s;
	}

	.skills a:hover,
	.skills a:focus-visible {
		transform: translate(-2px, -2px);
		box-shadow: 4px 4px 0 var(--ink);
		outline: none;
	}

	.skills code {
		color: var(--accent);
		font-size: 0.8rem;
	}

	.skills h3 {
		margin: 0.4rem 0;
		font-size: 1rem;
		line-height: 1.3;
	}

	.skills p {
		margin: 0 0 0.75rem;
		color: var(--muted);
		font-size: 0.85rem;
	}

	.more {
		margin-top: auto;
		color: var(--accent);
		font-size: 0.8rem;
	}

	@media (max-width: 680px) {
		.hero {
			grid-template-columns: 1fr;
			justify-items: center;
			text-align: center;
			gap: 2rem;
		}

		.skills {
			grid-template-columns: 1fr;
		}
	}
</style>
