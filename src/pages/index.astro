---
import { Image } from 'astro:assets';
import me from '../assets/me.jpg';

const skills = [
	{
		cmd: 'frontend',
		title: 'Frontend Development',
        body: 'Fast, clean, modern interfaces for simple or complex workflows.',
	},
	{
		cmd: 'backend',
		title: 'Backend Development',
        body: 'APIs, data models, and reliable services at any scale.',
	},
	{
		cmd: 'infra',
		title: 'Cloud Infrastructure',
		body: 'CI/CD, containers, and cloud infra that ships and stays up.',
	},
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Gilbert Yoder — software developer in Bonners Ferry, Idaho. Frontend, backend, DevOps and cloud."
		/>
		<title>Gilbert Yoder — Software Developer</title>
	</head>
	<body>
		<main>
			<header class="top">
				<span>gyoder.dev</span>
				<span>Bonners Ferry, ID</span>
			</header>

			<section class="hero">
				<figure class="photo">
					<Image
						src={me}
						alt="Portrait of Gilbert Yoder"
						width={480}
						height={600}
						fit="cover"
						position="center"
						quality={80}
						loading="eager"
					/>
				</figure>

				<div class="intro">
					<p class="prompt">$ whoami</p>
					<h1>Gilbert Yoder</h1>
					<p class="lede">
						Software developer who can do <em>anything</em> between the browser and the
						data center.
					</p>
					<p class="loc">📍 Bonners Ferry, Idaho</p>
					<a class="btn" href="mailto:yodergilbert1@gmail.com?subject=Hello%20Gilbert">
						Get in touch →
					</a>
				</div>
			</section>

			<section>
				<h2><span class="hash">##</span> What I do</h2>
				<ul class="skills">
					{
						skills.map((s) => (
							<li>
								<code>./{s.cmd}</code>
								<h3>{s.title}</h3>
								<p>{s.body}</p>
							</li>
						))
					}
				</ul>
			</section>

			<footer>
				<p>$ echo "let's build something"<span class="cursor">▍</span></p>
			</footer>
		</main>
	</body>
</html>

<style is:global>
	:root {
		--paper: #f4eee0;
		--paper-edge: #e8dfc9;
		--ink: #26231e;
		--muted: #6f675a;
		--accent: #b4452b;
		--rule: #cfc4aa;
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		background-color: var(--paper);
		background-image:
			radial-gradient(circle at 1px 1px, rgba(38, 35, 30, 0.07) 1px, transparent 0);
		background-size: 22px 22px;
		color: var(--ink);
		font-family: ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, Consolas, monospace;
		font-size: 16px;
		line-height: 1.6;
	}

	main {
		max-width: 760px;
		margin: 3rem auto;
		padding: 2.5rem;
		background: var(--paper);
		border: 2px solid var(--ink);
		box-shadow: 8px 8px 0 var(--ink);
	}

	.top {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px dashed var(--rule);
		color: var(--muted);
		font-size: 0.85rem;
	}

	.hero {
		display: grid;
		grid-template-columns: 240px 1fr;
		gap: 2.5rem;
		align-items: center;
		padding: 2.5rem 0;
	}

	.photo {
		position: relative;
		margin: 0;
		width: 240px;
		height: 300px;
		border: 2px solid var(--ink);
		background: var(--paper-edge);
		box-shadow: 5px 5px 0 var(--accent);
		transform: rotate(-1.5deg);
		overflow: hidden;
	}

	.photo img {
		position: relative;
		z-index: 1;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: sepia(0.2) contrast(1.05);
	}

	.prompt {
		margin: 0;
		color: var(--accent);
	}

	h1 {
		margin: 0.25rem 0 0.75rem;
		font-size: clamp(2rem, 6vw, 3rem);
		line-height: 1.1;
		letter-spacing: -0.03em;
	}

	.lede {
		margin: 0 0 0.75rem;
		font-size: 1.1rem;
	}

	.lede em {
		font-style: normal;
		background: linear-gradient(transparent 55%, rgba(180, 69, 43, 0.3) 55%);
	}

	.loc {
		margin: 0;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.btn {
		display: inline-block;
		margin-top: 1.25rem;
		padding: 0.6rem 1.1rem;
		border: 2px solid var(--ink);
		background: var(--accent);
		color: var(--paper);
		font-weight: 700;
		text-decoration: none;
		box-shadow: 4px 4px 0 var(--ink);
		transition: transform 0.12s, box-shadow 0.12s;
	}

	.btn:hover {
		transform: translate(2px, 2px);
		box-shadow: 2px 2px 0 var(--ink);
	}

	.btn:focus-visible {
		outline: 2px solid var(--ink);
		outline-offset: 3px;
	}

	h2 {
		margin: 0 0 1.25rem;
		padding-top: 1.5rem;
		border-top: 1px dashed var(--rule);
		font-size: 1.1rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.hash {
		color: var(--accent);
	}

	.skills {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(3, 1fr);
	}

	.skills li {
		padding: 1rem;
		border: 1.5px solid var(--ink);
		background: var(--paper-edge);
		transition: transform 0.15s, box-shadow 0.15s;
	}

	.skills li:hover {
		transform: translate(-2px, -2px);
		box-shadow: 4px 4px 0 var(--ink);
	}

	.skills code {
		color: var(--accent);
		font-size: 0.8rem;
	}

	.skills h3 {
		margin: 0.4rem 0;
		font-size: 1rem;
		line-height: 1.3;
	}

	.skills p {
		margin: 0;
		color: var(--muted);
		font-size: 0.85rem;
	}

	footer {
		margin-top: 2.5rem;
		padding-top: 1rem;
		border-top: 1px dashed var(--rule);
		color: var(--muted);
		font-size: 0.9rem;
	}

	footer p {
		margin: 0;
	}

	.cursor {
		color: var(--accent);
		animation: blink 1.1s steps(1) infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	@media (max-width: 680px) {
		main {
			margin: 1rem;
			padding: 1.25rem;
			box-shadow: 5px 5px 0 var(--ink);
		}

		.hero {
			grid-template-columns: 1fr;
			justify-items: center;
			text-align: center;
			gap: 2rem;
		}

		.skills {
			grid-template-columns: 1fr;
		}
	}
</style>
