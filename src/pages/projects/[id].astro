---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { id: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const isVideo = (src: string) => /\.(webm|mp4|mov)$/i.test(src);
---

<Base title={`${data.title} — Gilbert Yoder`} description={data.summary}>
	<article>
		<a class="back" href="/#projects">← Back</a>
		<h1>{data.title}</h1>
		<p class="lede">{data.summary}</p>

		{
			data.tags.length > 0 && (
				<ul class="tags">
					{data.tags.map((t) => <li>{t}</li>)}
				</ul>
			)
		}

		<div class="prose">
			<Content />
		</div>

		{data.link && <a class="btn" href={data.link} target="_blank" rel="noopener">Visit {data.title} →</a>}

		<div class="media">
			{
				data.media.map((m) =>
					isVideo(m.src) ? (
						<video src={m.src} autoplay muted loop playsinline preload="metadata" aria-label={m.alt} />
					) : (
						<img src={m.src} alt={m.alt} loading="lazy" decoding="async" />
					),
				)
			}
		</div>
	</article>
</Base>

<script>
	// Respect reduced-motion: stop autoplaying videos and show controls instead.
	if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		for (const v of document.querySelectorAll<HTMLVideoElement>('.media video')) {
			v.pause();
			v.removeAttribute('autoplay');
			v.controls = true;
		}
	}
</script>

<style>
	article {
		padding-top: 2rem;
	}

	/* Keep reading text to a comfortable line length on the wider layout. */
	.lede,
	.prose {
		max-width: 72ch;
	}

	.back {
		display: inline-block;
		margin-bottom: 1.5rem;
		color: var(--muted);
		font-size: 0.9rem;
		text-decoration: none;
	}

	.back:hover {
		color: var(--accent);
	}

	.lede {
		margin: 0 0 1.5rem;
		color: var(--muted);
		font-size: 1.1rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0 0 1.5rem;
		padding: 0;
		list-style: none;
	}

	.tags li {
		padding: 0.05rem 0.45rem;
		border: 1px solid var(--rule);
		color: var(--muted);
		font-size: 0.75rem;
	}

	.prose :global(h2) {
		margin-top: 2rem;
	}

	.prose :global(h2)::before {
		content: '## ';
		color: var(--accent);
	}

	.prose :global(ul) {
		padding-left: 1.25rem;
	}

	.prose :global(li::marker) {
		content: '- ';
		color: var(--accent);
	}

	.media {
		display: grid;
		gap: 1.5rem;
		margin-top: 2rem;
	}

	.media img,
	.media video {
		display: block;
		width: 100%;
		height: auto;
		border: 1.5px solid var(--line);
		background: var(--line);
	}
</style>
