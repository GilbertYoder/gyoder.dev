---
// Line icons for the service cards. Stroke uses currentColor so they follow the theme.
interface Props {
	name: 'frontend' | 'backend' | 'cloud' | 'ai';
}

const { name } = Astro.props;
---

<svg
	class="service-icon"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	{
		name === 'frontend' && (
			<>
				<rect x="2.5" y="4" width="19" height="16" rx="1" />
				<path d="M2.5 8.5h19M9 12.5l-2.5 2.5 2.5 2.5M15 12.5l2.5 2.5-2.5 2.5" />
			</>
		)
	}
	{
		name === 'backend' && (
			<>
				<rect x="3" y="3.5" width="18" height="7" rx="1" />
				<rect x="3" y="13.5" width="18" height="7" rx="1" />
				<path d="M7 7h.01M7 17h.01M11 7h6M11 17h6" />
			</>
		)
	}
	{name === 'cloud' && <path d="M7 19h10.5a4.5 4.5 0 0 0 .6-8.96A6.5 6.5 0 0 0 5.6 11.2 4 4 0 0 0 7 19z" />}
	{
		name === 'ai' && (
			<path d="M10 3.5l1.6 4.9 4.9 1.6-4.9 1.6L10 16.5l-1.6-4.9L3.5 10l4.9-1.6zM18.5 14l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8z" />
		)
	}
</svg>
